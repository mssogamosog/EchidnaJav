@page "/"
@using EchidnaJav.Core.Domain.DTOs
@using EchidnaJav.Core.Domain.States
@using EchidnaJav.Core.Infrastructure.Persistence
@using EchidnaJav.Core.Infrastructure.Services
@inject IMovieRepositoryService MovieRepo
@inject AppPreferencesState AppPrefs
@inject TransientUIState UI
@inject SearchFilterState SearchFilter
@inject NavigationCacheState NavCache
@inject NavigationManager Nav
@inject INavigationStateService NavState
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="_workspaceContainer" class="movie-workspace">
    <div class="movie-grid" style="--card-width:@($"{EffectiveWidth}px")" @onclick="ClearSelection">
        @for (int i = 0; i < Movies.Count; i++)
        {
            var index = i; // Local copy for the lambda closure
            var movie = Movies[i];

            <MovieCard @key="movie.Id"
                       Movie="movie"
                       UseFullImage="AppPrefs.UseWideView"
                       IsSelected="_selectedMovieIds.Contains(movie.Id)"
                       OnMovieClicked="(e) => HandleMovieClick(movie, index, e)"
                       OnMovieRightClicked="(e) => HandleRightClick(movie, index, e)" />
        }
    </div>

    @if (hasMore)
    {
        <div @ref="_triggerElement" class="load-more-trigger">
            @if (isLoading)
            {
                <span class="loading-spinner">Loading...</span>
            }
        </div>
    }
    else if (Movies.Any())
    {
        <div class="pagination-area">
            <p class="end-of-list">No more movies to load.</p>
        </div>
    }

    <MovieContextMenu IsVisible="_isMenuVisible"
                      X="_menuX" Y="_menuY"
                      SelectedMovies="GetSelectedMovieObjects()"
                      OnClose="() => _isMenuVisible = false"
                      OnMoviesUpdated="HandleMoviesUpdated" />
</div>

@code {
    [Parameter] public string? FixedActress { get; set; }

    private List<MovieDto> Movies = new();
    private ElementReference _triggerElement;
    private DotNetObjectReference<Home>? _dotnetRef;
    private CancellationTokenSource? _cts;
    private bool _disposed = false;
    private string? _appliedActress;
    private ElementReference _workspaceContainer;
    private DotNetObjectReference<Home>? _clickOutsideDotNetRef;
    private IDisposable? _locationRegistration;

    private int EffectiveWidth => AppPrefs.UseWideView ? (int)(AppPrefs.CardWidth * 2.1) : AppPrefs.CardWidth;

    // Dynamic Cache Key: "Home" for the main page, or "Actress_Name" for actress filtering
    private string CurrentPageKey => string.IsNullOrEmpty(FixedActress) ? "Home" : $"Actress_{FixedActress}";

    private bool isLoading = false;
    private bool hasMore = true;
    private bool _observerRegistered = false;

    // --- SELECTION STATE ---
    private HashSet<string> _selectedMovieIds = new();
    private int _lastSelectedIndex = -1;
    private bool _isMenuVisible = false;
    private double _menuX;
    private double _menuY;

    protected override async Task OnInitializedAsync()
    {
        AppPrefs.OnChange += Refresh;
        SearchFilter.OnSearchChanged += HandleSearchChanged;
        _locationRegistration = Nav.RegisterLocationChangingHandler(OnLocationChanging);
        NavState.OnReloadRequested += HandleReloadRequested;
        LoadFromCache();
    }
    private void HandleReloadRequested()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        InvokeAsync(async () =>
                {
                    if (_disposed) return;

                    NavCache.ResetCache(CurrentPageKey);
                    Movies.Clear();
                    ClearSelection();
                    hasMore = true;
                    isLoading = false;
                    await LoadMore();
                });
    }
    protected override async Task OnParametersSetAsync()
    {
        var currentRelativePath = Nav.ToBaseRelativePath(Nav.Uri);
        var activeActress = string.IsNullOrEmpty(currentRelativePath) ? null : FixedActress;

        if (_appliedActress != activeActress)
        {
            _appliedActress = activeActress;
            Movies.Clear();
            ClearSelection();
            hasMore = true;

            LoadFromCache();
            StateHasChanged();
        }
    }

    private void LoadFromCache()
    {
        var cache = NavCache.GetCache(CurrentPageKey);
        if (cache.Movies.Any())
        {
            Movies = new List<MovieDto>(cache.Movies);
            hasMore = cache.HasMore;
            SearchFilter.SetTotalCount(cache.TotalCount);
        }
    }

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        try
        {
            var scroll = await JS.InvokeAsync<double>("getScrollPos");
            NavCache.GetCache(CurrentPageKey).ScrollPosition = scroll;
        }
        catch { }
    }

    // --- SELECTION & CONTEXT MENU HANDLERS ---
    private async Task HandleMovieClick(MovieDto movie, int index, MouseEventArgs e)
    {
        _isMenuVisible = false;

        if (e.CtrlKey || e.MetaKey)
        {
            if (_selectedMovieIds.Contains(movie.Id)) _selectedMovieIds.Remove(movie.Id);
            else _selectedMovieIds.Add(movie.Id);

            _lastSelectedIndex = index;
            StateHasChanged();
        }
        else if (e.ShiftKey && _lastSelectedIndex != -1)
        {
            _selectedMovieIds.Clear();
            var start = Math.Min(_lastSelectedIndex, index);
            var end = Math.Max(_lastSelectedIndex, index);

            for (int i = start; i <= end && i < Movies.Count; i++)
            {
                _selectedMovieIds.Add(Movies[i].Id);
            }
            StateHasChanged();
        }
        else
        {
            Nav.NavigateTo($"/movie/{movie.Id}");
        }
    }

    private void HandleRightClick(MovieDto movie, int index, MouseEventArgs e)
    {
        if (!_selectedMovieIds.Contains(movie.Id))
        {
            _selectedMovieIds.Clear();
            _selectedMovieIds.Add(movie.Id);
            _lastSelectedIndex = index;
            StateHasChanged();
        }

        _menuX = e.ClientX;
        _menuY = e.ClientY;
        _isMenuVisible = true;
    }

    private void ClearSelection()
    {
        if (_selectedMovieIds.Any() || _isMenuVisible)
        {
            _selectedMovieIds.Clear();
            _isMenuVisible = false;
            StateHasChanged();
        }
    }

    private List<MovieDto> GetSelectedMovieObjects() => Movies.Where(m => _selectedMovieIds.Contains(m.Id)).ToList();

    private async Task HandleMoviesUpdated()
    {
        _isMenuVisible = false;
        ClearSelection();
        StateHasChanged();
    }

    // --- EXISTING HANDLERS ---
    private void HandleSearchChanged()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        InvokeAsync(async () =>
        {
            if (_disposed) return;
            if (_observerRegistered)
            {
                try { await JS.InvokeVoidAsync("infiniteScroll.unobserve", _triggerElement); } catch { }
                _observerRegistered = false;
            }

            NavCache.ResetCache(CurrentPageKey); // Reset cache for new search
            Movies.Clear();
            ClearSelection();
            hasMore = true;
            isLoading = false;
            await LoadMore();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _clickOutsideDotNetRef = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("clickOutsideHandler.addEvent", _workspaceContainer, _clickOutsideDotNetRef); } catch { }

            if (Movies.Any())
            {
                double targetScroll = NavCache.GetCache(CurrentPageKey).ScrollPosition;
                if (targetScroll > 0)
                {
                    await JS.InvokeVoidAsync("setScrollPos", targetScroll);
                }
            }
        }

        if (!Movies.Any() && hasMore && !isLoading)
        {
            await LoadMore();
        }

        if (hasMore && !_observerRegistered)
        {
            _observerRegistered = true;
            _dotnetRef ??= DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("infiniteScroll.observe", _triggerElement, _dotnetRef); }
            catch { _observerRegistered = false; }
        }
    }

    [JSInvokable]
    public async Task OnScrollToBottom()
    {
        if (!isLoading && hasMore) await LoadMore();
    }

    [JSInvokable]
    public void OnClickedOutside() => ClearSelection();

    private async Task LoadMore(CancellationToken ct = default)
    {
        if (isLoading || !hasMore || _disposed || ct.IsCancellationRequested) return;

        isLoading = true;
        StateHasChanged();

        try
        {
            int columns = 1;
            try { columns = await JS.InvokeAsync<int>("getGridColumns"); } catch { }
            if (columns < 1) columns = 1;

            int remainder = Movies.Count % columns;
            int missingToFillRow = (columns - remainder) % columns;
            int targetItems = 50;
            int rowsToAdd = (int)Math.Ceiling((double)targetItems / columns);
            int dynamicPageSize = missingToFillRow + (rowsToAdd * columns);

            string rawSearch = SearchFilter.SearchText ?? string.Empty;
            bool wantsNoCover = rawSearch.Contains("no-cover", StringComparison.OrdinalIgnoreCase);
            string cleanSearchText = rawSearch.Replace("no-cover", "", StringComparison.OrdinalIgnoreCase).Trim();

            var queryParams = new MovieQueryParameters
            {
                SearchText = cleanSearchText,
                MissingImageOnly = wantsNoCover,
                Skip = Movies.Count,
                Take = dynamicPageSize,
                SortBy = SearchFilter.CurrentSort,
                SearchActress = _appliedActress
            };

            if (Movies.Count == 0)
            {
                var total = await MovieRepo.GetTotalMovieCountAsync(queryParams);
                if (ct.IsCancellationRequested) return;

                SearchFilter.SetTotalCount(total);
                NavCache.GetCache(CurrentPageKey).TotalCount = total;
            }

            var result = await MovieRepo.GetMoviesAsync(queryParams);
            if (result != null && result.Any())
            {
                var newMovies = result.Where(fetched => !Movies.Any(existing => existing.Id == fetched.Id)).ToList();
                if (newMovies.Any()) Movies.AddRange(newMovies);

                if (result.Count() < dynamicPageSize) hasMore = false;

                // Sync the loaded data back to the dictionary cache dynamically!
                var cache = NavCache.GetCache(CurrentPageKey);
                cache.Movies = new List<MovieDto>(Movies);
                cache.HasMore = hasMore;
            }
            else
            {
                hasMore = false;
            }
        }
        catch (Exception)
        {
            hasMore = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    void Refresh() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();

        AppPrefs.OnChange -= Refresh;
        SearchFilter.OnSearchChanged -= HandleSearchChanged;
        NavState.OnReloadRequested -= HandleReloadRequested;
        _locationRegistration?.Dispose();
        if (_clickOutsideDotNetRef != null)
        {
            try { await JS.InvokeVoidAsync("clickOutsideHandler.removeEvent", _workspaceContainer); } catch { }
            _clickOutsideDotNetRef.Dispose();
        }

        if (_dotnetRef != null)
        {
            try { await JS.InvokeVoidAsync("infiniteScroll.unobserve", _triggerElement); } catch { }
            _dotnetRef.Dispose();
        }
    }
}