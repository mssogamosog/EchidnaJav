@page "/"
@using EchidnaJav.Core.Domain.DTOs
@using EchidnaJav.Core.Domain.Entities
@using EchidnaJav.Core.Domain.States
@using EchidnaJav.Core.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject IMovieRepositoryService MovieRepo
@inject UIState UI
@inject SearchState SearchState
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="movie-grid" style="--card-width:@($"{EffectiveWidth}px")">
    @foreach (var movie in Movies)
    {
        <MovieCard @key="movie.Id" Movie="movie" UseFullImage="UI.UseWideView" />
    }
</div>

@if (hasMore)
{
    <div @ref="_triggerElement" class="load-more-trigger">
        @if (isLoading)
        {
            <span class="loading-spinner">Loading...</span>
        }
    </div>
}
else if (Movies.Any())
{
    <div class="pagination-area">
        <p class="end-of-list">No more movies to load.</p>
    </div>
}

@code {
    private List<MovieDto> Movies = new();
    private ElementReference _triggerElement;
    private DotNetObjectReference<Home>? _dotnetRef;
    private CancellationTokenSource? _cts;
    private bool _disposed = false;

    private int EffectiveWidth => UI.UseWideView
        ? (int)(UI.CardWidth * 2.1)
        : UI.CardWidth;

    private bool isLoading = false;
    private bool hasMore = true;
    private bool _observerRegistered = false;

    protected override void OnInitialized()
    {
        UI.OnChange += Refresh;
        SearchState.OnSearchChanged += HandleSearchChanged;
        if (SearchState.CachedMovies.Any())
        {
            Movies = new List<MovieDto>(SearchState.CachedMovies);
            hasMore = SearchState.HasMoreCached;
        }
    }
    private void HandleSearchChanged()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        InvokeAsync(async () =>
        {
            if (_disposed) return;
            if (_observerRegistered)
            {
                try { await JS.InvokeVoidAsync("infiniteScroll.unobserve", _triggerElement); } catch { }
                _observerRegistered = false;
            }
            
            Movies.Clear();
            hasMore = true;
            isLoading = false;
            
            await LoadMore();
            
        });
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (Movies.Any())
            {
                if (SearchState.ScrollPosition > 0)
                {
                    await JS.InvokeVoidAsync("setScrollPos", SearchState.ScrollPosition);
                }
            }
            else
            {
                await LoadMore();
            }
        }

        if (hasMore && !_observerRegistered)
        {
            _observerRegistered = true;
            _dotnetRef ??= DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("infiniteScroll.observe", _triggerElement, _dotnetRef); }
            catch { _observerRegistered = false; }
        }
    }

    [JSInvokable]
    public async Task OnScrollToBottom()
    {
        if (!isLoading && hasMore)
        {
            await LoadMore();
        }
    }

    private async Task LoadMore(CancellationToken ct = default)
    {
        if (isLoading || !hasMore || _disposed || ct.IsCancellationRequested) return;

        isLoading = true;
        StateHasChanged();

        try
        {
            int columns = 1;
            try
            {
                columns = await JS.InvokeAsync<int>("getGridColumns");
                if (columns < 1) columns = 1;
            }
            catch { /* Fallback if JS fails */ }
           

            
            
            int remainder = Movies.Count % columns;
            int missingToFillRow = (columns - remainder) % columns;
            
            int targetItems = 50;
            int rowsToAdd = (int)Math.Ceiling((double)targetItems / columns);
            int dynamicPageSize = missingToFillRow + (rowsToAdd * columns);
            string rawSearch = SearchState.SearchText ?? string.Empty;
            bool wantsNoCover = rawSearch.Contains("no-cover", StringComparison.OrdinalIgnoreCase); 
            string cleanSearchText = rawSearch.Replace("no-cover", "", StringComparison.OrdinalIgnoreCase).Trim();

            var queryParams = new MovieQueryParameters
            {
                SearchText = cleanSearchText, // Grab text from state
                MissingImageOnly = wantsNoCover,
                Skip = Movies.Count,
                Take = dynamicPageSize,
                SortBy = SearchState.CurrentSort
            };           

            if (Movies.Count == 0)
            {
                var total = await MovieRepo.GetTotalMovieCountAsync(queryParams);
                if (ct.IsCancellationRequested) return;
                SearchState.SetTotalCount(total);

            }
            
            var result = await MovieRepo.GetMoviesAsync(queryParams);

            if (result != null && result.Any())
            {
                var newMovies = result.Where(fetched => !Movies.Any(existing => existing.Id == fetched.Id)).ToList();

                if (newMovies.Any())
                {
                    Movies.AddRange(newMovies);
                }
    
                if (result.Count() < dynamicPageSize)
                {
                    hasMore = false;
                }

                SearchState.CachedMovies = new List<MovieDto>(Movies);
                SearchState.HasMoreCached = hasMore;
            }
            else
            {
                hasMore = false;
                SearchState.HasMoreCached = false;
            }
        }
        catch (Exception)
        {       
            hasMore = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
        UI.OnChange -= Refresh;
        SearchState.OnSearchChanged -= HandleSearchChanged;        
        try
        {
            SearchState.ScrollPosition = await JS.InvokeAsync<double>("getScrollPos");
        }
        catch { /* Ignore if JS interop is already disconnected */ }

        if (_dotnetRef != null)
        {
            try { await JS.InvokeVoidAsync("infiniteScroll.unobserve", _triggerElement); }
            catch { }
            
            _dotnetRef.Dispose();
        }
    }
}