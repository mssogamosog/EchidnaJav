@page "/"
@using EchidnaJav.Core.Domain.Entities
@using EchidnaJav.Core.Domain.States
@using EchidnaJav.Core.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject UIState UI
@implements IDisposable

@if (movies == null)
{
    <p>Loading...</p>
}
else
{
    <div class="movie-grid"
         style="--card-width:@($"{EffectiveWidth}px")">

        @foreach (var movie in movies)
        {
            <MovieCard Movie="movie" UseFullImage="UI.UseWideView" />
        }

    </div>
}

@code {
    private List<Movie> movies;

    private int EffectiveWidth => UI.UseWideView
    ? (int)(UI.CardWidth * 2.1)
    : UI.CardWidth;

    protected override async Task OnInitializedAsync()
    {
        movies = await Db.Movies
            .Include(m => m.Files)
            .ToListAsync();
    }

    protected override void OnInitialized()
    {
        UI.OnChange += Refresh;
    }

    void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UI.OnChange -= Refresh;
    }
}