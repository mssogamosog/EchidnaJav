@page "/"
@using EchidnaJav.Domain.Entities
@using EchidnaJav.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db

<h3>Movies</h3>

<div class="d-flex align-items-center gap-3 mb-3">

    <!-- Toggle view -->
    <button class="btn btn-sm btn-secondary"
            @onclick="ToggleView">
        View: @(useFullImage ? "Full" : "Cover")
    </button>

    <!-- Size slider -->
    <input type="range"
           min="120"
           max="400"
           step="10"
           @bind="cardWidth" />

    <span>@cardWidth px</span>

</div>

@if (movies == null)
{
    <p>Loading...</p>
}
else
{
    <div class="movie-grid"
         style="--card-width:@($"{cardWidth}px")">

        @foreach (var movie in movies)
        {
            <MovieCard Movie="movie" UseFullImage="useFullImage" />
        }

    </div>
}

@code {
    private List<Movie> movies;
    private bool useFullImage = false;

    // default sizes depending on mode
    private int cardWidth = 180;

    protected override async Task OnInitializedAsync()
    {
        movies = await Db.Movies
            .Include(m => m.Files)
            .ToListAsync();
    }

    private void ToggleView()
    {
        useFullImage = !useFullImage;
        cardWidth = useFullImage ? 260 : 160;
    }
}