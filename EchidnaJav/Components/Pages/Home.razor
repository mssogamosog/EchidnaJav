@page "/"
@using EchidnaJav.Core.Domain.DTOs
@using EchidnaJav.Core.Domain.Entities
@using EchidnaJav.Core.Domain.States
@using EchidnaJav.Core.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject IMovieRepositoryService MovieRepo
@inject UIState UI
@implements IDisposable

@if (movies == null)
{
    <p>Loading...</p>
}
else
{
    <div class="movie-grid"
         style="--card-width:@($"{EffectiveWidth}px")">

        @foreach (var movie in movies)
        {
            <MovieCard Movie="movie" UseFullImage="UI.UseWideView" />
        }

    </div>
}

@code {
    private List<MovieDto> movies = new();

    private int EffectiveWidth => UI.UseWideView
    ? (int)(UI.CardWidth * 2.1)
    : UI.CardWidth;


    private int pageSize = 100;
    private int currentPage = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadMore();
    }

    private async Task LoadMore()
    {
        var result = await MovieRepo.GetMoviesAsync( 0, int.MaxValue);

        movies.AddRange(result);
        currentPage++;

        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        UI.OnChange += Refresh;
    }

    void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UI.OnChange -= Refresh;
    }
}