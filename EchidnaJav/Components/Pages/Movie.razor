@page "/movie/{Id}"
@using EchidnaJav.Core.Domain.DTOs
@using EchidnaJav.Core.Infrastructure.Persistence
@using EchidnaJav.Core.Infrastructure.Services
@inject IMovieRepositoryService Repo
@inject IImageService ImageService

@if (movie == null)
{
    <p>Loading...</p>
}
else
{
    <div class="movie-page-container">

        <!-- HEADER IMAGE -->
        <div class="media-header-area">
            <img src="@fullImage" class="full-cover-img" />

            <div class="media-controls-overlay">
                @if (movie.Files.Any())
                {
                    <button class="btn-play">▶ Play @movie.Id</button>
                }
            </div>
        </div>

        <!-- TITLE -->
        <div class="title-area">
            <div class="title-header">
                <h1>@movie.Title</h1>
                <span class="movie-id">@movie.Id</span>
            </div>
        </div>

        <!-- DETAILS -->
        <div class="details-area">

            <!-- POSTER -->
            <div class="poster-container">
                <img src="@posterImage" class="poster-img" />
            </div>

            <!-- INFO -->
            <div class="info-container">
                <div class="info-grid">

                    <div>Released:</div>
                    <div>@(movie.Premiered?.ToString("yyyy-MM-dd") ?? "Unknown")</div>

                    <div>Runtime:</div>
                    <div>@(movie.Runtime ?? 0) min</div>

                    <div>Studio:</div>
                    <div>@movie.Studio</div>

                    <div>Director:</div>
                    <div>@movie.Director</div>

                    <div>Cast:</div>
                    <div>
                        @foreach (var actor in movie.Cast)
                        {
                            <span class="actor-name">@actor</span>
                        }
                    </div>
                </div>

                <!-- PLOT -->
                @if (!string.IsNullOrEmpty(movie.Plot))
                {
                    <div class="plot-box">
                        <p>@movie.Plot</p>
                    </div>
                }

                <!-- GENRES -->
                <div class="tags-container">
                    @foreach (var g in movie.Genres)
                    {
                        <span class="genre-tag">@g</span>
                    }
                </div>

                <!-- FILES -->
                <div class="files-container">
                    <h5>Available Files</h5>

                    @foreach (var file in movie.Files)
                    {
                        <div class="file-item">
                            🎬 @file.FileName
                        </div>
                    }
                </div>

            </div>
        </div>

        <!-- SIDEBAR -->
        <div class="sidebar">
            <h3>Recommended</h3>
            <p>(Coming later)</p>
        </div>
    </div>
}
@code {
    [Parameter] public string Id { get; set; }

    private MovieDetailsDto? movie;

    private string? fullImage;
    private string? posterImage;

    protected override async Task OnInitializedAsync()
    {
        movie = await Repo.GetMovieDetailsAsync(Id);

        if (movie != null)
        {
            fullImage = await ImageService.GetImageAsync(movie.ImagePath, ImageType.Full);
            posterImage = await ImageService.GetImageAsync(movie.ImagePath, ImageType.Cover);
        }
    }
}