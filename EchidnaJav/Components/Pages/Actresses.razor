@page "/actresses"
@using EchidnaJav.Core.Domain.DTOs
@using EchidnaJav.Core.Domain.States
@using EchidnaJav.Core.Infrastructure.Persistence
@using EchidnaJav.Core.Infrastructure.Helpers
@using EchidnaJav.Core.Infrastructure.Services
@inject IActressRepositoryService Repo
@inject NavigationManager Nav
@inject TransientUIState UI
@inject SearchFilterState SearchFilter
@inject NavigationCacheState NavCache
@inject INavigationStateService NavState
@inject IJSRuntime JS
@implements IDisposable

<div class="actresses-page-container" @onclick="ClearSelection">
    <div class="actresses-grid">
        @if (actressList != null)
        {
            @for (int i = 0; i < actressList.Count; i++)
            {
                var index = i;
                var actress = actressList[i];

                <ActressCard @key="actress.Name"
                             Actress="@actress"
                             HighlightText="@GetHighlightText(actress)"
                             IsSelected="_selectedActressNames.Contains(actress.Name)"
                             OnActressClicked="(e) => HandleActressClick(actress, index, e)"
                             OnActressRightClicked="(e) => HandleRightClick(actress, index, e)" />
            }
        }
    </div>

    <ActressContextMenu IsVisible="_isMenuVisible"
                        X="_menuX" Y="_menuY"
                        SelectedActresses="GetSelectedActressObjects()"
                        OnMergeClicked="OpenMergeModal"
                        OnClose="() => _isMenuVisible = false" />

    <MergeActressesModal IsVisible="_isModalVisible"
                         ActressesToMerge="GetSelectedActressObjects()"
                         OnClose="() => _isModalVisible = false"
                         OnMergeConfirmed="ExecuteMerge" />
</div>
@code {
    private List<ActressDetailsDto>? actressList;
    private IDisposable? _locationRegistration;
    private const string _currentPageKey = "Actresses";
    private bool _isDisposed = false;
    // Selection state
    private HashSet<string> _selectedActressNames = new();
    private int _lastSelectedIndex = -1;

    // Context Menu state
    private bool _isMenuVisible = false;
    private double _menuX;
    private double _menuY;

    // Modal state
    private bool _isModalVisible = false;
    protected override async Task OnInitializedAsync()
    {
        UI.SetFooterText("Actresses");
        SearchFilter.OnSearchChanged += ReloadActresses;
        _locationRegistration = Nav.RegisterLocationChangingHandler(OnLocationChanging);
        NavState.OnReloadRequested += HandleReloadRequested;
        await FetchData();
    }

    private async void ReloadActresses()
    {
        if (_isDisposed) return; 

        await FetchData();

        if (!_isDisposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task FetchData()
    {
        actressList = await Repo.GetAllActressesAsync(SearchFilter.SearchText, SearchFilter.CurrentActressSort);
    }

    private string? GetHighlightText(ActressDetailsDto a)
    {
        return SearchFilter.CurrentActressSort switch
        {
            SortActressesBy.MovieCount => $"{a.MovieCount} Movies",
            SortActressesBy.AgeYoungest or SortActressesBy.AgeOldest => a.GetCurrentAgeDisplay(),
            SortActressesBy.HeightTallest or SortActressesBy.HeightShortest =>
                a.Height.GetValueOrDefault(0) > 0 ? $"{a.Height} cm" : null,

            SortActressesBy.CupSmallest or SortActressesBy.CupBiggest =>
                        !string.IsNullOrEmpty(a.Cup) ? $"Cup Size: {a.Cup}" : null,
            SortActressesBy.Birthday =>
                a.DobMonth.GetValueOrDefault(0) > 0
                    ? $"Birthday: {a.DobMonth:D2}/{a.DobDay:D2}"
                    : null,

            _ => null
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // When the page first renders and data is loaded, restore the scroll position
        if (firstRender)
        {

            var savedScroll = NavCache.GetCache(_currentPageKey).ScrollPosition;
            if (savedScroll > 0)
            {
                // A small delay ensures the DOM has fully populated the grid before scrolling
                await Task.Yield();
                await JS.InvokeVoidAsync("setScrollPos", savedScroll);
            }
            else if (firstRender)
            {
                await JS.InvokeVoidAsync("setScrollPos", 0);
            }
        }
    }
    private void HandleReloadRequested()
    {
        InvokeAsync(async () =>
        {
            if (_isDisposed) return;

            NavCache.ResetCache(_currentPageKey);
            ClearSelection();
            actressList = null;
            StateHasChanged();

            await FetchData();

            try
            {
                await JS.InvokeVoidAsync("setScrollPos", 0);
            }
            catch
            {
            }

            StateHasChanged();
        });
    }
    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        try
        {
            // Save the current scroll position into the generic dictionary right before the page changes
            double scroll = await JS.InvokeAsync<double>("getScrollPos");
            NavCache.GetCache(_currentPageKey).ScrollPosition = scroll;
        }
        catch
        {
            // Ignore JS interop errors during rapid navigation
        }
    }
    private async Task HandleActressClick(ActressDetailsDto actress, int index, MouseEventArgs e)
    {
        _isMenuVisible = false;

        if (e.CtrlKey || e.MetaKey)
        {
            if (_selectedActressNames.Contains(actress.Name)) _selectedActressNames.Remove(actress.Name);
            else _selectedActressNames.Add(actress.Name);
            _lastSelectedIndex = index;
            StateHasChanged();
        }
        else if (e.ShiftKey && _lastSelectedIndex != -1 && actressList != null)
        {
            _selectedActressNames.Clear();
            var start = Math.Min(_lastSelectedIndex, index);
            var end = Math.Max(_lastSelectedIndex, index);
            for (int i = start; i <= end && i < actressList.Count; i++)
            {
                _selectedActressNames.Add(actressList[i].Name);
            }
            StateHasChanged();
        }
        else
        {
            Nav.NavigateTo($"/actress/{Uri.EscapeDataString(actress.Name)}");
        }
    }

    private void HandleRightClick(ActressDetailsDto actress, int index, MouseEventArgs e)
    {
        if (!_selectedActressNames.Contains(actress.Name))
        {
            _selectedActressNames.Clear();
            _selectedActressNames.Add(actress.Name);
            _lastSelectedIndex = index;
            StateHasChanged();
        }

        _menuX = e.ClientX;
        _menuY = e.ClientY;
        _isMenuVisible = true;
    }

    private void ClearSelection()
    {
        if (_selectedActressNames.Any() || _isMenuVisible)
        {
            _selectedActressNames.Clear();
            _isMenuVisible = false;
            StateHasChanged();
        }
    }

    private List<ActressDetailsDto> GetSelectedActressObjects()
    {
        if (actressList == null) return new List<ActressDetailsDto>();
        return actressList.Where(a => _selectedActressNames.Contains(a.Name)).ToList();
    }

    private void OpenMergeModal()
    {
        _isMenuVisible = false;
        _isModalVisible = true;
    }

    private async Task ExecuteMerge(string targetActressName)
    {
        _isModalVisible = false;

        var sourceNames = _selectedActressNames.Where(n => n != targetActressName).ToList();

        // Execute the database merge
        await Repo.MergeActressesAsync(targetActressName, sourceNames);

        // Refresh the list immediately to show the updated state
        ClearSelection();
        ReloadActresses();
    }
    private void GoToActress(string name)
    {
        Nav.NavigateTo($"/actress/{Uri.EscapeDataString(name)}");
    }

    public void Dispose()
    {
        _isDisposed = true;
        SearchFilter.OnSearchChanged -= ReloadActresses;
        NavState.OnReloadRequested -= HandleReloadRequested;
        _locationRegistration?.Dispose();
    }
}