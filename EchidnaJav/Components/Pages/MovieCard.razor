@using EchidnaJav.Components.Common
@using EchidnaJav.Core.Domain
@using EchidnaJav.Core.Domain.DTOs
@using EchidnaJav.Core.Domain.States
@using EchidnaJav.Core.Infrastructure.Persistence
@using EchidnaJav.Core.Infrastructure.Services
@inject IJSRuntime JS
@inject IMovieRepositoryService MoviesRepo
@inject IImageService ImageService
@inject TransientUIState UI
@implements IAsyncDisposable


<div class="movie-card @(IsSelected ? "selected" : "")"
     style="cursor: pointer;"
     @ref="_element"
     @onmouseenter='() => UI.SetFooterText(Movie.Title)'
     @onmouseleave='() => UI.SetFooterText(null)'
     @onclick="OnClick"
     @onclick:stopPropagation="true"
     @oncontextmenu="OnRightClick"
     @oncontextmenu:preventDefault="true"
     @oncontextmenu:stopPropagation="true">

    <div class="cover-container @(UseFullImage ? "wide" : "poster")">
        @if (_currentImage != null)
        {
            <img src="@_currentImage" class="cover" alt="@Movie.Title cover" />
        }
        else
        {
            <div class="cover-placeholder"></div>
        }

        <button class="btn  favorite-indicator @(Movie.IsFavorite == true ? "glow-active" : "")"
                @onclick="ToggleFavoriteAsync"
                @onclick:stopPropagation="true">

            <Icon Name="@(Movie.IsFavorite == true ? AppIcon.HeartSolid : AppIcon.HeartOutline)" Size="22" />

        </button>
    </div>

    <div class="info">
        <div class="header">
            <div class="title id">[@Movie.Id] @Movie.Title</div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MovieCardDto Movie { get; set; } = default!;
    [Parameter] public bool UseFullImage { get; set; }
    [Parameter] public bool IsSelected { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnMovieClicked { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnMovieRightClicked { get; set; }
    private string? _currentImage;
    private ElementReference _element;
    private DotNetObjectReference<MovieCard>? _dotnetRef;
    private CancellationTokenSource? _cts;
    private string? _currentRequestKey;
    private bool _isVisible;
    private ImageType TargetImageType => UseFullImage ? ImageType.Thumbnail : ImageType.Cover;
    private async Task OnClick(MouseEventArgs e) => await OnMovieClicked.InvokeAsync(e);
    private async Task OnRightClick(MouseEventArgs e) => await OnMovieRightClicked.InvokeAsync(e);

    // This catches the event from the menu when data changes
    private async Task HandleMovieUpdated()
    {
        // If the cover changed, you might need to force the ImageService to reload here
        // _currentImage = null;
        // await LoadImageAsync(_cts.Token, _currentRequestKey);

        StateHasChanged();
    }
    protected override void OnInitialized()
    {
        ImageService.OnImageGenerated += HandleImageGenerated;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotnetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("imageObserver.observe", _element, _dotnetRef);
            }
            catch
            {
                // ignore (render race)
            }
        }
    }
    // protected override bool ShouldRender()
    // {       
    //     return _currentImage != null;
    // }
    private async Task ToggleFavoriteAsync()
    {
        Movie.IsFavorite = !(Movie.IsFavorite ?? false);

        try
        {
            await MoviesRepo.ToggleMovieFavoriteAsync(Movie.Id);
        }
        catch
        {
            Movie.IsFavorite = !Movie.IsFavorite;
        }
    }
    protected override void OnParametersSet()
    {
        var requestKey = $"{Movie.Id}_{UseFullImage}";

        if (_currentRequestKey == requestKey) return;

        _currentRequestKey = requestKey;
        _currentImage = null;

        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();

        if (_isVisible)
        {
            _ = LoadImageAsync(_cts.Token, requestKey);
        }
    }

    [JSInvokable]
    public async Task OnVisible()
    {
        if (_isVisible) return;
        _isVisible = true;

        if (_currentImage == null)
        {
            _cts ??= new CancellationTokenSource();
            await LoadImageAsync(_cts.Token, _currentRequestKey!);
        }
    }

    [JSInvokable]
    public void OnHidden()
    {
        _isVisible = false;
        _cts?.Cancel();
    }

    private async Task LoadImageAsync(CancellationToken token, string requestKey)
    {
        try
        {
            if (string.IsNullOrEmpty(Movie.ImagePath) || token.IsCancellationRequested) return;

            var img = await ImageService.GetImageAsync(Movie.ImagePath, TargetImageType);

            if (token.IsCancellationRequested || _currentRequestKey != requestKey) return;

            if (!string.IsNullOrEmpty(img))
            {
                _currentImage = img;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { /* ignore */ }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Image load error: {ex}");
        }
    }

    // Removed async void
    private void HandleImageGenerated(string path)
    {
        if (string.IsNullOrEmpty(Movie.ImagePath)) return;

        var expected = ImageService.GetCachePath(Movie.ImagePath, TargetImageType);
        if (path != expected) return;

        // Ensure UI thread update without making the event handler async void
        InvokeAsync(async () =>
        {
            try
            {
                _currentImage = await ImageService.GetImageAsync(Movie.ImagePath, TargetImageType);
                StateHasChanged();
            }
            catch { /* ignore */ }
        });
    }

    public async ValueTask DisposeAsync()
    {
        ImageService.OnImageGenerated -= HandleImageGenerated;
        
        _cts?.Cancel();
        _cts?.Dispose();

        if (_dotnetRef != null)
        {
            try
            {
                await JS.InvokeVoidAsync("imageObserver.unobserve", _element);
            }
            catch { /* ignore */ }
            
            _dotnetRef.Dispose();
        }
    }
}