@using EchidnaJav.Components.Common
@using EchidnaJav.Core.Domain
@using EchidnaJav.Core.Domain.DTOs
@using EchidnaJav.Core.Domain.States
@using EchidnaJav.Core.Infrastructure.Helpers
@using EchidnaJav.Core.Infrastructure.Persistence
@using EchidnaJav.Core.Infrastructure.Services
@inject IJSRuntime JS
@inject IActressRepositoryService ActressRepo
@inject IImageService ImageService
@inject TransientUIState UI
@implements IAsyncDisposable

<div class="actress-card @(IsSelected ? "selected" : "")"
     style="cursor: pointer;"
     @ref="_element"
     @onmouseenter='() => UI.SetFooterText(Actress.Name)'
     @onmouseleave='() => UI.SetFooterText(null)'
     @onclick="OnClick"
     @onclick:stopPropagation="true"
     @oncontextmenu="OnRightClick"
     @oncontextmenu:preventDefault="true"
     @oncontextmenu:stopPropagation="true">

    <div class="portrait-container">
        @if (_currentImage != null)
        {
            <img src="@_currentImage" class="portrait" alt="@Actress.Name portrait" />
        }
        else
        {
            <div class="portrait-placeholder">
                <span class="bi bi-person-fill placeholder-icon"></span>
            </div>
        }
        <button class="btn btn-link p-0 border-0 favorite-indicator @(Actress.IsFavorite == true ? "glow-active" : "")"
                @onclick="ToggleFavoriteAsync"
                @onclick:stopPropagation="true">
            <Icon Name="@(Actress.IsFavorite == true ? AppIcon.HeartSolid : AppIcon.HeartOutline)" Size="24" />
        </button>
        @if (ShowExtendedDetailsOverlay)
        {
            <div class="details-overlay">
                <div class="overlay-stat"><span class="stat-label">Movies:</span> @Actress.MovieCount</div>
                <div class="overlay-stat"><span class="stat-label">Age:</span> @Actress.GetCurrentAgeDisplay()</div>

                @if (Actress.Height.GetValueOrDefault(0) > 0)
                {
                    <div class="overlay-stat"><span class="stat-label">Height:</span> @Actress.Height cm</div>
                }

                @if (!string.IsNullOrEmpty(Actress.Cup))
                {
                    <div class="overlay-stat"><span class="stat-label">Cup:</span> @Actress.Cup</div>

                    @if (Actress.Bust.GetValueOrDefault(0) > 0)
                    {
                        <div class="overlay-stat"><span class="stat-label">BWH:</span> @Actress.Bust-@Actress.Waist-@Actress.Hips</div>
                    }
                }
            </div>
        }
    </div>

    <div class="info">
        <div class="actress-name">@Actress.Name</div>
        @if (!string.IsNullOrEmpty(HighlightText))
        {
            <div class="actress-highlight">@HighlightText</div>
        }
        else if (!string.IsNullOrEmpty(Actress.JapaneseName))
        {
            <div class="actress-jp-name">@Actress.JapaneseName</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ActressDetailsDto Actress { get; set; } = default!;
    [Parameter] public EventCallback<MouseEventArgs> OnActressClicked { get; set; }
    [Parameter] public string? HighlightText { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnActressRightClicked { get; set; }
    [Parameter] public bool ShowExtendedDetailsOverlay { get; set; } = false;

    private string? _currentImage;
    private ElementReference _element;
    private DotNetObjectReference<ActressCard>? _dotnetRef;
    private CancellationTokenSource? _cts;
    private string? _currentRequestKey;
    private bool _isVisible;
    private ImageType TargetImageType => ImageType.Full;

    private async Task OnClick(MouseEventArgs e) => await OnActressClicked.InvokeAsync(e);
    private async Task OnRightClick(MouseEventArgs e) => await OnActressRightClicked.InvokeAsync(e);

    protected override void OnInitialized()
    {
        ImageService.OnImageGenerated += HandleImageGenerated;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotnetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("imageObserver.observe", _element, _dotnetRef);
            }
            catch { /* ignore */ }
        }
    }

    private string? GetPrimaryImagePath()
    {
        return Actress.Images?.FirstOrDefault()?.Filepath;
    }
    private async Task ToggleFavoriteAsync()
    {
        Actress.IsFavorite = !(Actress.IsFavorite ?? false);
        await ActressRepo.ToggleActressFavoriteAsync(Actress.Id);
    }

    protected override void OnParametersSet()
    {
        var imagePath = GetPrimaryImagePath();
        var requestKey = $"{Actress.Name}_{imagePath}";

        if (_currentRequestKey == requestKey) return;

        _currentRequestKey = requestKey;
        _currentImage = null;

        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();

        if (_isVisible)
        {
            _ = LoadImageAsync(_cts.Token, requestKey);
        }
    }

    [JSInvokable]
    public async Task OnVisible()
    {
        if (_isVisible) return;
        _isVisible = true;

        if (_currentImage == null)
        {
            _cts ??= new CancellationTokenSource();
            await LoadImageAsync(_cts.Token, _currentRequestKey!);
        }
    }

    [JSInvokable]
    public void OnHidden()
    {
        _isVisible = false;
        _cts?.Cancel();
    }

    private async Task LoadImageAsync(CancellationToken token, string requestKey)
    {
        var imagePath = GetPrimaryImagePath();
        try
        {
            if (string.IsNullOrEmpty(imagePath) || token.IsCancellationRequested) return;

            var img = await ImageService.GetImageAsync(imagePath, TargetImageType);

            if (token.IsCancellationRequested || _currentRequestKey != requestKey) return;

            if (!string.IsNullOrEmpty(img))
            {
                _currentImage = img;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { /* ignore */ }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Image load error: {ex}");
        }
    }

    private void HandleImageGenerated(string path)
    {
        var imagePath = GetPrimaryImagePath();
        if (string.IsNullOrEmpty(imagePath)) return;

        var expected = ImageService.GetCachePath(imagePath, TargetImageType);
        if (path != expected) return;

        InvokeAsync(async () =>
        {
            try
            {
                _currentImage = await ImageService.GetImageAsync(imagePath, TargetImageType);
                StateHasChanged();
            }
            catch { /* ignore */ }
        });
    }

    public async ValueTask DisposeAsync()
    {
        ImageService.OnImageGenerated -= HandleImageGenerated;

        _cts?.Cancel();
        _cts?.Dispose();

        if (_dotnetRef != null)
        {
            try
            {
                await JS.InvokeVoidAsync("imageObserver.unobserve", _element);
            }
            catch { /* ignore */ }

            _dotnetRef.Dispose();
        }
    }
}