@using EchidnaJav.Core.Domain.States
@inject ScraperActressState ScraperState
@implements IDisposable

@if (ScraperState.IsProcessing)
{
    <div class="compact-widget @(isMinimized ? "minimized" : "")">
        <div class="cw-header">
            <span class="cw-title">Actresses</span>
            
            @* 🔥 Dynamically change the text based on minimized state *@
            <span class="cw-count">
                @(isMinimized
                    ? $"{ScraperState.ProcessedCount} / {ScraperState.RemainingCount}"
                    : $"{ScraperState.ProcessedCount} / {ScraperState.RemainingCount}")
            </span>

            <button class="cw-toggle-btn" @onclick="ToggleMinimize" title="Toggle Size">
                @(isMinimized ? "+" : "−")
            </button>
        </div>

        @if (!isMinimized)
        {
            <div class="cw-body">
                <div class="cw-track">
                    <div class="cw-fill" style="width: @($"{Percentage}%")"></div>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool isMinimized = false;
    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    private double Percentage => ScraperState.TotalQueued == 0
        ? 0
        : ((double)ScraperState.ProcessedCount / ScraperState.TotalQueued) * 100;

    protected override void OnInitialized()
    {
        // 🔥 THE FIX: We no longer subscribe to OnChange.
        // Instead, we start a steady 300ms heartbeat.
        _timer = new PeriodicTimer(TimeSpan.FromMilliseconds(300));
        _ = StartPolling();
    }

    private async Task StartPolling()
    {
        try
        {
            bool wasProcessing = false;
            
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                bool isProcessing = ScraperState.IsProcessing;
                
                if (isProcessing || wasProcessing)
                {
                    await InvokeAsync(StateHasChanged);
                }
                wasProcessing = isProcessing;
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        // Clean up the timer when the widget is destroyed
        _cts.Cancel();
        _cts.Dispose();
        _timer?.Dispose();
    }

    private void ToggleMinimize() => isMinimized = !isMinimized;
}