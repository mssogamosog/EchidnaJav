@using EchidnaJav.Components.Common
@using EchidnaJav.Components.Pages
@using EchidnaJav.Core.Domain
@using EchidnaJav.Core.Domain.DTOs
@using EchidnaJav.Core.Domain.States
@using EchidnaJav.Core.Infrastructure.Services
@inherits LayoutComponentBase

@inject AppPreferencesState AppPrefs
@inject TransientUIState UI
@inject SearchFilterState SearchFilter
@inject NavigationCacheState NavCache
@inject IJSRuntime JS
@inject INavigationStateService NavState
@inject NavigationManager NavManager
@implements IAsyncDisposable

<div class="app-shell">

    <header class="header-bar">

        <div class="logo">EchidnaJav</div>

        <div class="page-title">Home</div>

        <input class="search-box"
               placeholder="Search movies..."
               value="@_searchInput"
               @oninput="HandleSearchInput" />
        <button class="nav-btn" @onclick="ToggleTheme" title="@(isDarkMode ? "Light Mode" : "Dark Mode")" style="font-size: 1.1rem;">
            @if (isDarkMode)
            {
                <span>☀️</span>
            }
            else
            {
                <span>🌙</span>
            }
        </button>
    </header>
    <div class="main-shell">
        <div class="sidebar">
            <NavMenu />
        </div>
        <div class="right-shell">

       

        <div class="body-shell">
            <div class="content-shell">
                <div class="toolbar">
                    <div class="filters-left">
                        <select class="toolbar-select" disabled>
                            <option>All Genres</option>
                        </select>

                        <select class="toolbar-select" disabled>
                            <option>All Actresses</option>
                        </select>

                        <div class="sort-container">
                            <span class="sort-label">Sort by:</span>

                            @if (IsActressesListPage)
                            {
                                <select class="toolbar-select" value="@SearchFilter.CurrentActressSort" @onchange="HandleActressSortChange">
                                    @foreach (SortActressesBy sortOption in Enum.GetValues(typeof(SortActressesBy)))
                                    {
                                        <option value="@sortOption">@GetActressSortName(sortOption)</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <select class="toolbar-select" value="@SearchFilter.CurrentSort" @onchange="HandleSortChange">
                                    @foreach (SortMoviesBy sortOption in Enum.GetValues(typeof(SortMoviesBy)))
                                    {
                                        <option value="@sortOption">@GetSortName(sortOption)</option>
                                    }
                                </select>
                            }
                        </div>
                    </div>
                </div>

                <div class="sub-navigation-bar">
                    <div class="sub-nav-left">
                        <div class="browser-controls">
                            <button class="nav-btn" disabled="@(!NavState.CanGoBack)" @onclick="NavState.GoBack" title="Go Back">
                                <Icon Name="AppIcon.GoBack" Size="18" />
                            </button>

                            <button class="nav-btn" disabled="@(!NavState.CanGoForward)" @onclick="NavState.GoForward" title="Go Forward">
                                <Icon Name="AppIcon.GoForward" Size="18" />
                            </button>

                            <button class="nav-btn reload-btn" @onclick="NavState.Reload" title="Reload">
                                <Icon Name="AppIcon.Reload" Size="18" />
                            </button>
                        </div>
                    </div>

                    <div class="sub-nav-center">
                        @if (IsMoviePage)
                        {
                            <div class="movie-controls">
                                <button class="movie-nav-btn" title="Previous Movie" disabled="@(!CanGoPrevious)" @onclick="GoToPrevious">
                                    <Icon Name="AppIcon.PreviousMovie" Size="16" />
                                    <span></span>
                                </button>

                                <button class="movie-nav-btn" title="Next Movie" disabled="@(!CanGoNext)" @onclick="GoToNext">
                                    <span></span>
                                    <Icon Name="AppIcon.NextMovie" Size="16" />
                                </button>
                            </div>
                        }
                    </div>

                    <div class="sub-nav-right">
                        <div class="view-buttons">
                            <button class="@(AppPrefs.UseWideView ? "" : "active")" @onclick="AppPrefs.SetPosterView">▦</button>
                            <button class="@(AppPrefs.UseWideView ? "active" : "")" @onclick="AppPrefs.SetWideView">▭</button>
                        </div>
                    </div>
                </div>

                <main class="content-area">
                    @Body
                </main>

                @if (!(IsMoviePage || IsActressesListPage))
                {
                    <div class="size-slider-shell">
                        <div class="size-slider">
                            <input type="range"
                                   min="120"
                                   max="320"
                                   step="10"
                                   value="@AppPrefs.CardWidth"
                                   @oninput="LiveResize"
                                   @onchange="SaveResize" />
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="widget-stack-container">
            <ScraperProgressWidget />
        </div>

        
        </div>
    </div>
    <footer class="status-bar">
        <div class="status-left">
            @if (UI.SelectedMoviesCount > 0)
            {
                <span>@UI.SelectedMoviesCount movie(s) selected</span>
            }
            else if (!string.IsNullOrEmpty(UI.FooterText))
            {
                <span>@UI.FooterText</span>
            }
        </div>

        <div class="status-right">
            Displaying @NavCache.GetCache(NavCache.LastActiveListKey).Movies.Count of @SearchFilter.TotalDatabaseCount
        </div>
    </footer>
</div>

@code {
    private bool IsMoviePage => NavManager.ToBaseRelativePath(NavManager.Uri).StartsWith("movie/", StringComparison.OrdinalIgnoreCase);
    private bool IsActressPage => NavManager.ToBaseRelativePath(NavManager.Uri).StartsWith("actress/", StringComparison.OrdinalIgnoreCase);
    private bool IsActressesListPage => NavManager.ToBaseRelativePath(NavManager.Uri).Equals("actresses", StringComparison.OrdinalIgnoreCase);

    private string? CurrentMovieId
    {
        get
        {
            var path = NavManager.ToBaseRelativePath(NavManager.Uri);
            if (path.StartsWith("movie/", StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(path.Substring(6));
            }
            return null;
        }
    }

    private bool CanGoPrevious => CurrentMovieId != null && NavCache.GetPreviousMovieId(NavCache.LastActiveListKey, CurrentMovieId) != null;
    private bool CanGoNext => CurrentMovieId != null && NavCache.GetNextMovieId(NavCache.LastActiveListKey, CurrentMovieId) != null;

    private string _searchInput = string.Empty;
    private System.Timers.Timer? _debounceTimer;
    private DotNetObjectReference<MainLayout>? objRef;

    bool menuOpen = true;
    bool isMobile = false;
    private bool isDarkMode;


    protected override void OnInitialized()
    {
        NavState.StateChanged += StateHasChanged;
        NavManager.LocationChanged += OnLocationChanged;

        SearchFilter.OnSearchChanged += StateHasChanged;
        SearchFilter.OnMetadataChanged += StateHasChanged;
        AppPrefs.OnChange += SafeRefresh;
        UI.OnChange += SafeRefresh;

        _debounceTimer = new System.Timers.Timer(400);
        _debounceTimer.AutoReset = false;
        _debounceTimer.Elapsed += PerformSearch;

    }
    
    private async Task ToggleTheme()
    {
        if (Microsoft.Maui.Controls.Application.Current != null)
        {
            isDarkMode = !isDarkMode;

            Microsoft.Maui.Controls.Application.Current.UserAppTheme = isDarkMode
                ? Microsoft.Maui.ApplicationModel.AppTheme.Dark
                : Microsoft.Maui.ApplicationModel.AppTheme.Light;
        }
        await ApplyThemeToWebView();
    }
    private async Task ApplyThemeToWebView()
    {
        // Injects data-theme="dark" or data-theme="light" into the main HTML tag
        var themeName = isDarkMode ? "dark" : "light";
        await JS.InvokeVoidAsync("document.documentElement.setAttribute", "data-theme", themeName);
    }
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Track the last viewed grid to allow next/previous on the Movie page
        var path = NavManager.ToBaseRelativePath(e.Location);
        if (string.IsNullOrEmpty(path))
        {
            NavCache.LastActiveListKey = "Home";
        }
        else if (path.StartsWith("actress/", StringComparison.OrdinalIgnoreCase))
        {
            var parts = path.Split('/');
            if (parts.Length > 1) NavCache.LastActiveListKey = $"Actress_{Uri.UnescapeDataString(parts[1])}";
        }

        InvokeAsync(StateHasChanged);
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        _searchInput = e.Value?.ToString() ?? string.Empty;
        _debounceTimer?.Stop();
        _debounceTimer?.Start();
    }

    private void HandleSortChange(ChangeEventArgs e)
    {
        if (Enum.TryParse<SortMoviesBy>(e.Value?.ToString(), out var newSort))
        {
            SearchFilter.SetSort(newSort);

            var currentPath = NavManager.ToBaseRelativePath(NavManager.Uri);
            if (ShouldRedirectToHome(currentPath))
            {
                NavManager.NavigateTo("/");
            }
        }
    }

    private string GetSortName(SortMoviesBy sort) => sort switch
    {
        SortMoviesBy.ID => "Movie ID",
        SortMoviesBy.RecentlyAdded => "Recently Added",
        SortMoviesBy.DateNewest => "Release Date (Newest)",
        SortMoviesBy.DateOldest => "Release Date (Oldest)",
        SortMoviesBy.ActressName => "Actress Name (A-Z)",
        _ => sort.ToString()
    };

    private void PerformSearch(object? sender, System.Timers.ElapsedEventArgs e)
    {
        InvokeAsync(async () =>
        {
            var currentPath = NavManager.ToBaseRelativePath(NavManager.Uri);

            if (ShouldRedirectToHome(currentPath))
            {
                NavManager.NavigateTo("/");
                await Task.Delay(50);
            }
            SearchFilter.SetSearchText(_searchInput);

            StateHasChanged();
        });
    }

    async Task LiveResize(ChangeEventArgs e)
    {
        var value = e.Value!.ToString();
        await JS.InvokeVoidAsync("setCardWidth", $"{value}px");
    }
    private bool ShouldRedirectToHome(string path)
    {
        if (string.IsNullOrEmpty(path)) return false; 

        if (path.Equals("actresses", StringComparison.OrdinalIgnoreCase)) return false; 

        if (path.StartsWith("actress/", StringComparison.OrdinalIgnoreCase)) return false; 

        return true; 
    }
    void SaveResize(ChangeEventArgs e)
    {
        AppPrefs.SetWidth(int.Parse(e.Value!.ToString()!));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var currentTheme = Microsoft.Maui.Controls.Application.Current?.RequestedTheme;
            isDarkMode = currentTheme == Microsoft.Maui.ApplicationModel.AppTheme.Dark;
            await ApplyThemeToWebView();
            objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerResizeHandler", objRef);
            await JS.InvokeVoidAsync("registerGlobalKeyHandler", objRef);

            var width = await JS.InvokeAsync<int>("getWindowWidth");

            isMobile = width < 900;
            menuOpen = !isMobile;

            StateHasChanged();

        }
    }

    [JSInvokable]
    public void OnBrowserResize(int width)
    {
        bool nowMobile = width < 900;
        if (nowMobile != isMobile)
        {
            isMobile = nowMobile;
            if (isMobile) menuOpen = false;
            else menuOpen = true;

            InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public void OnGlobalArrowLeft()
    {
        if (IsMoviePage && CanGoPrevious)
        {
            GoToPrevious();
            InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public void OnGlobalArrowRight()
    {
        if (IsMoviePage && CanGoNext)
        {
            GoToNext();
            InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        NavState.StateChanged -= StateHasChanged;
        NavManager.LocationChanged -= OnLocationChanged;
        SearchFilter.OnSearchChanged -= StateHasChanged;
        SearchFilter.OnMetadataChanged -= StateHasChanged;
        AppPrefs.OnChange -= SafeRefresh;
        UI.OnChange -= SafeRefresh;

        objRef?.Dispose();

        if (_debounceTimer != null)
        {
            _debounceTimer.Elapsed -= PerformSearch;
            _debounceTimer.Dispose();
        }
    }

    private void GoToPrevious()
    {
        if (CurrentMovieId != null)
        {
            var prevId = NavCache.GetPreviousMovieId(NavCache.LastActiveListKey, CurrentMovieId);
            if (prevId != null)
            {
                NavManager.NavigateTo($"/movie/{Uri.EscapeDataString(prevId)}", replace: true);
            }
        }
    }

    private void SafeRefresh()
    {
        InvokeAsync(() =>
        {
            try { StateHasChanged(); }
            catch (ObjectDisposedException) { }
        });
    }

    private void GoToNext()
    {
        if (CurrentMovieId != null)
        {
            var nextId = NavCache.GetNextMovieId(NavCache.LastActiveListKey, CurrentMovieId);
            if (nextId != null)
            {
                NavManager.NavigateTo($"/movie/{Uri.EscapeDataString(nextId)}", replace: true);
            }
        }
    }
    private void HandleActressSortChange(ChangeEventArgs e)
    {
        if (Enum.TryParse<SortActressesBy>(e.Value?.ToString(), out var newSort))
        {
            SearchFilter.SetActressSort(newSort);
        }
    }

    private string GetActressSortName(SortActressesBy sort) => sort switch
    {
        SortActressesBy.Name => "Name (A-Z)",
        SortActressesBy.MovieCount => "Movie Count",
        SortActressesBy.AgeYoungest => "Age (Youngest)",
        SortActressesBy.AgeOldest => "Age (Oldest)",
        SortActressesBy.HeightTallest => "Height (Tallest)",
        SortActressesBy.HeightShortest => "Height (Shortest)",
        SortActressesBy.CupSmallest => "Cup Size (Smallest)",
        SortActressesBy.CupBiggest => "Cup Size (Biggest)",
        SortActressesBy.Birthday => "Birthday",
        _ => sort.ToString()
    };
}