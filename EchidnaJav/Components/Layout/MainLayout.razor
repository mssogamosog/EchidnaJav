@using EchidnaJav.Components.Pages
@using EchidnaJav.Core.Domain.DTOs
@using EchidnaJav.Core.Domain.States
@using EchidnaJav.Core.Infrastructure.Services
@inherits LayoutComponentBase
@inject UIState UI
@inject SearchState SearchState
@inject IJSRuntime JS
@inject INavigationStateService NavState
@inject NavigationManager NavManager
@implements IAsyncDisposable

<div class="app-shell">

    <div class="main-shell">

        <header class="header-bar">

            <button class="menu-btn" @onclick="ToggleMenu">☰</button>
            
            <div class="logo">
                EchidnaJav
            </div>

            <div class="page-title">
                Home
            </div>

            <input class="search-box"
                   placeholder="Search movies..."
                   value="@_searchInput"
                   @oninput="HandleSearchInput" />

        </header>

        @if (menuOpen && isMobile)
        {
            <div class="menu-backdrop" @onclick="CloseMenu"></div>
        }

        <div class="body-shell">

            <aside class="sidebar @(menuOpen ? "open" : "closed")">
                <NavMenu />
            </aside>
            <div class="content-shell">

                <div class="toolbar">
                    <div class="filters-left">
        
                        <select class="toolbar-select" disabled>
                            <option>All Genres</option>
                        </select>

                        <select class="toolbar-select" disabled>
                            <option>All Actresses</option>
                        </select>

                        <div class="sort-container">
                            <span class="sort-label">Sort by:</span>
                            <select class="toolbar-select"
                                    value="@SearchState.CurrentSort"
                                    @onchange="HandleSortChange">
                                @foreach (SortMoviesBy sortOption in Enum.GetValues(typeof(SortMoviesBy)))
                                {
                                    <option value="@sortOption">@GetSortName(sortOption)</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="sub-navigation-bar">

                    <div class="sub-nav-left">
                        <div class="browser-controls">
                            <button class="nav-btn" disabled="@(!NavState.CanGoBack)" @onclick="NavState.GoBack" title="Go Back">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
                                </svg>
                            </button>

                            <button class="nav-btn" disabled="@(!NavState.CanGoForward)" @onclick="NavState.GoForward" title="Go Forward">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z" />
                                </svg>
                            </button>

                            <button class="nav-btn reload-btn" @onclick="NavState.Reload" title="Reload">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                                    <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="sub-nav-center">
                        @if (IsMoviePage)
                        {
                            <div class="movie-controls">
                                <button class="movie-nav-btn" title="Previous Movie" disabled="@(!CanGoPrevious)" @onclick="GoToPrevious">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z" />
                                    </svg>
                                    <span></span>
                                </button>

                                <button class="movie-nav-btn" title="Next Movie" disabled="@(!CanGoNext)" @onclick="GoToNext">
                                    <span></span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z" />
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>

                    <div class="sub-nav-right">
                        <div class="view-buttons">
                            <button class="@(UI.UseWideView ? "" : "active")" @onclick="UI.SetPosterView">▦</button>
                            <button class="@(UI.UseWideView ? "active" : "")" @onclick="UI.SetWideView">▭</button>
                        </div>
                    </div>

                </div>
                
                <main class="content-area">
                    @Body
                </main>
                
                @if (!IsMoviePage)
                {
                    <div class="size-slider-shell">
                        <div class="size-slider">
                            <input type="range"
                                   min="120"
                                   max="320"
                                   step="10"
                                   value="@UI.CardWidth"
                                   @oninput="LiveResize"
                                   @onchange="SaveResize" />
                        </div>
                    </div>
                }
            </div>

        </div>
        <div class="widget-stack-container">
            <ScraperProgressWidget />
        </div>
        
        <footer class="status-bar">
            <div class="status-left">
                @if (UI.SelectedMoviesCount > 0)
                {
                    <span>@UI.SelectedMoviesCount movie(s) selected</span>
                }
                else if (!string.IsNullOrEmpty(UI.FooterText))
                {
                    <span>@UI.FooterText</span>
                }
            </div>

            <div class="status-right">
                Displaying @SearchState.DisplayedMoviesCount of @SearchState.TotalDatabaseCount
            </div>
        </footer>
    </div>
</div>

@code {
    private bool IsMoviePage => NavManager.ToBaseRelativePath(NavManager.Uri)
                                          .StartsWith("movie/", StringComparison.OrdinalIgnoreCase);

    private bool IsActressPage => NavManager.ToBaseRelativePath(NavManager.Uri)
                                            .StartsWith("actress/", StringComparison.OrdinalIgnoreCase);
    private string? CurrentMovieId
    {
        get
        {
            var path = NavManager.ToBaseRelativePath(NavManager.Uri);
            if (path.StartsWith("movie/", StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(path.Substring(6)); // Strip "movie/"
            }
            return null;
        }
    }

    private bool CanGoPrevious => CurrentMovieId != null && SearchState.GetPreviousMovieId(CurrentMovieId) != null;
    private bool CanGoNext => CurrentMovieId != null && SearchState.GetNextMovieId(CurrentMovieId) != null;
    private string _searchInput = string.Empty;
    private System.Timers.Timer? _debounceTimer;
    private DotNetObjectReference<MainLayout>? objRef;
    
    bool menuOpen = true;
    bool isMobile = false;

    void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    void CloseMenu()
    {
        menuOpen = false;
    }

    protected override void OnInitialized()
    {
        NavState.StateChanged += StateHasChanged;        
        NavManager.LocationChanged += OnLocationChanged;
        SearchState.OnSearchChanged += StateHasChanged;
        SearchState.OnMetadataChanged += StateHasChanged;
        UI.OnChange += SafeRefresh;
        _debounceTimer = new System.Timers.Timer(400);
        _debounceTimer.AutoReset = false;
        _debounceTimer.Elapsed += PerformSearch;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
      
        InvokeAsync(StateHasChanged);
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        _searchInput = e.Value?.ToString() ?? string.Empty;
        _debounceTimer?.Stop();
        _debounceTimer?.Start();
    }
    private void HandleSortChange(ChangeEventArgs e)
    {
        if (Enum.TryParse<SortMoviesBy>(e.Value?.ToString(), out var newSort))
        {
            SearchState.SetSort(newSort);

            var currentPath = NavManager.ToBaseRelativePath(NavManager.Uri);
            if (currentPath != "" && !currentPath.StartsWith("actress/", StringComparison.OrdinalIgnoreCase))
            {
                NavManager.NavigateTo("/");
            }
        }
    }

    private string GetSortName(SortMoviesBy sort) => sort switch
    {
        SortMoviesBy.ID => "Movie ID",
        SortMoviesBy.RecentlyAdded => "Recently Added",
        SortMoviesBy.DateNewest => "Release Date (Newest)",
        SortMoviesBy.DateOldest => "Release Date (Oldest)",        
        SortMoviesBy.ActressName => "Actress Name (A-Z)",        
        _ => sort.ToString()
    };
    private void PerformSearch(object? sender, System.Timers.ElapsedEventArgs e)
    {
        InvokeAsync(() =>
        {
            SearchState.SetSearchText(_searchInput);
            var currentPath = NavManager.ToBaseRelativePath(NavManager.Uri);
            if (currentPath != "" && !currentPath.StartsWith("actress/", StringComparison.OrdinalIgnoreCase))
            {
                NavManager.NavigateTo("/");
            }
            
            StateHasChanged();
        });
    }

    async Task LiveResize(ChangeEventArgs e)
    {
        var value = e.Value!.ToString();
        await JS.InvokeVoidAsync("setCardWidth", $"{value}px");
    }

    void SaveResize(ChangeEventArgs e)
    {
        UI.SetWidth(int.Parse(e.Value!.ToString()!));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync("registerResizeHandler", objRef);
            await JS.InvokeVoidAsync("registerGlobalKeyHandler", objRef);

            var width = await JS.InvokeAsync<int>("getWindowWidth");

            isMobile = width < 900;
            menuOpen = !isMobile;

            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnBrowserResize(int width)
    {
        bool nowMobile = width < 900;

        // only react when breakpoint changes
        if (nowMobile != isMobile)
        {
            isMobile = nowMobile;

            if (isMobile)
                menuOpen = false;   // entering mobile closes
            else
                menuOpen = true;    // entering desktop opens
                
            InvokeAsync(StateHasChanged);
        }
    }
    [JSInvokable]
    public void OnGlobalArrowLeft()
    {
        // Only trigger if we are actually looking at a movie, and a previous one exists
        if (IsMoviePage && CanGoPrevious)
        {
            GoToPrevious();
            InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public void OnGlobalArrowRight()
    {
        // Only trigger if we are actually looking at a movie, and a next one exists
        if (IsMoviePage && CanGoNext)
        {
            GoToNext();
            InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        NavState.StateChanged -= StateHasChanged;
        NavManager.LocationChanged -= OnLocationChanged;
        SearchState.OnSearchChanged -= StateHasChanged;
        SearchState.OnMetadataChanged -= StateHasChanged;
        UI.OnChange -= SafeRefresh;
        objRef?.Dispose();

        // Safely dispose of the timer
        if (_debounceTimer != null)
        {
            _debounceTimer.Elapsed -= PerformSearch;
            _debounceTimer.Dispose();
        }
    }
    private void GoToPrevious()
    {
        if (CurrentMovieId != null)
        {
            var prevId = SearchState.GetPreviousMovieId(CurrentMovieId);
            if (prevId != null)
            {
                NavManager.NavigateTo($"/movie/{Uri.EscapeDataString(prevId)}", replace: true);
            }
        }
    }
    private void SafeRefresh()
    {
        InvokeAsync(() =>
        {
            try { StateHasChanged(); }
            catch (ObjectDisposedException) { }
        });
    }
    private void GoToNext()
    {
        if (CurrentMovieId != null)
        {
            var nextId = SearchState.GetNextMovieId(CurrentMovieId);
            if (nextId != null)
            {
                NavManager.NavigateTo($"/movie/{Uri.EscapeDataString(nextId)}", replace: true);
            }
        }
    }
}