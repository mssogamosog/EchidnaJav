@using CommunityToolkit.Maui.Storage
@using EchidnaJav.Components.Common
@using EchidnaJav.Core.Domain
@using EchidnaJav.Core.Domain.DTOs
@using EchidnaJav.Core.Domain.States
@using EchidnaJav.Core.Infrastructure.Services
@inject IImportService ImportService
@inject ImportState ImportState
@inject SearchFilterState SearchFilter
@inject NavigationManager Nav
@implements IDisposable


<nav class="nav-container">
    <div class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <Icon Name="AppIcon.Home"  CssClass="menu-icon" />
            <span class="nav-text">Home</span>
        </NavLink>
    </div>

    <div class="nav-item">
        <NavLink class="nav-link" href="actresses">
            <Icon Name="AppIcon.Actresses"  CssClass="menu-icon" />
            <span class="nav-text">Actresses</span>
        </NavLink>
    </div>

    <div class="nav-item">
        <button class="nav-link @(SearchFilter.FavoritesOnly ? "active" : "")"
                @onclick="ToggleFavorites">
            <Icon Name="@(SearchFilter.FavoritesOnly ? AppIcon.HeartSolid : AppIcon.HeartOutline)" CssClass="menu-icon" />
            <span class="nav-text">Favorites</span>
        </button>
    </div>

    <div class="nav-item">
        <button class="nav-link"
                @onclick="PickFolder"
                disabled="@ImportState.IsRunning">
            <Icon Name="AppIcon.Folder"  CssClass="menu-icon" />
            <span class="nav-text">@(ImportState.IsRunning ? "Importing..." : "Import Folder")</span>
        </button>
    </div>
</nav>

@code {
    protected override void OnInitialized()
    {
        // We still subscribe here solely to update the "Import Folder" button text/disabled state
        ImportState.OnChange += SafeStateHasChanged;
        SearchFilter.OnSearchChanged += SafeStateHasChanged;
    }

    public void Dispose()
    {
        ImportState.OnChange -= SafeStateHasChanged;
        SearchFilter.OnSearchChanged -= SafeStateHasChanged;
    }

    private void SafeStateHasChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleFavorites()
    {
        SearchFilter.ToggleFavoritesOnly();
        var currentUrl = Nav.ToBaseRelativePath(Nav.Uri);
        if (!string.IsNullOrEmpty(currentUrl) && !currentUrl.StartsWith("movie", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("");
        }
        else if (currentUrl.StartsWith("movie", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("");
        }
    }

    private async Task PickFolder()
    {
        var result = await FolderPicker.Default.PickAsync();

        if (result?.Folder?.Path is string rootPath)
        {
            ImportState.Cts = new CancellationTokenSource();
            ImportState.IsRunning = true;
            ImportState.Progress = new ImportProgress { Status = "Starting...", Processed = 0, Total = 0 };
            ImportState.Notify();

            var progressHandler = new Progress<ImportProgress>(p =>
            {
                ImportState.Progress = p;
                ImportState.Notify();
            });

            try
            {
                await ImportService.ImportFromFolderAsync(rootPath, progressHandler, ImportState.Cts.Token);
            }
            catch (OperationCanceledException)
            {
                ImportState.Progress.Status = "Cancelled";
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Import Failed: {ex.Message}");
                ImportState.Progress.Status = "Error Occurred";
            }
            finally
            {
                await Task.Delay(1500);
                ImportState.IsRunning = false;
                ImportState.Notify();
            }
        }
    }
}