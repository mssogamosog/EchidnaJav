<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EchidnaJav.Scraper.Views.CloudflareSolverPage" 
             Title="Security Check"
             BackgroundColor="{AppThemeBinding Light=#CCF4F8FB, Dark=#CC0F161A}">
    <!-- CC is 80% opacity for the glass backdrop -->

    <!-- Modal Container -->
    <Border HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="450"
            HeightRequest="550"
            Stroke="{AppThemeBinding Light=#D0DDE5, Dark=#2E424D}"
            StrokeThickness="1"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A262D}"
            StrokeShape="RoundRectangle 14"
            Padding="0">

        <!-- Deep shadow to mimic the CSS box-shadow -->
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,10" Radius="30" Opacity="0.25" />
        </Border.Shadow>

        <Grid RowDefinitions="Auto, Auto, *, Auto">

            <!-- Header (Surface-2 Color) -->
            <Grid Grid.Row="0" Padding="20,16" BackgroundColor="{AppThemeBinding Light=#E8F0F5, Dark=#21313A}">
                <Label Text="Security Check Required" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#111A1F, Dark=#F0F5F9}" />
            </Grid>

            <!-- Instructions -->
            <Label Grid.Row="1" 
                   Padding="20,16,20,0"
                   Text="Please complete the captcha below. If the page redirects but gets stuck spinning, click Continue to resume scraping."
                   FontSize="13"
                   TextColor="{AppThemeBinding Light=#516675, Dark=#8B9EAC}" />

            <!-- WebView -->
            <WebView Grid.Row="2" 
                     x:Name="ChallengeWebView" 
                     Margin="20,10"
                     Navigated="OnWebViewNavigated" />

            <!-- Actions (Footer) -->
            <Grid Grid.Row="3" 
                  ColumnDefinitions="*,*" 
                  ColumnSpacing="12" 
                  Padding="20,16"
                  BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A262D}">

                <!-- Cancel (Uses Surface-2 styling so it's less prominent) -->
                <Button Grid.Column="0" 
                        Text="Cancel" 
                        Clicked="OnCancelClicked" 
                        CornerRadius="8"
                        FontAttributes="Bold"
                        Padding="0,12"
                        BackgroundColor="{AppThemeBinding Light=#E8F0F5, Dark=#21313A}"
                        TextColor="{AppThemeBinding Light=#111A1F, Dark=#F0F5F9}" />

                <!-- Continue (Uses Primary Theme Colors) -->
                <Button Grid.Column="1" 
                        Text="Continue Scraping" 
                        Clicked="OnContinueClicked" 
                        CornerRadius="8"
                        FontAttributes="Bold"
                        Padding="0,12"
                        BackgroundColor="{AppThemeBinding Light=#8CA600, Dark=#D4FF33}"
                        TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F161A}" />
            </Grid>
        </Grid>
    </Border>

</ContentPage>